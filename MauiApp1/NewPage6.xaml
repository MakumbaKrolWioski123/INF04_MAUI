<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiApp1.NewPage6"
             Title="Zadanie 7.3">
    <VerticalStackLayout HorizontalOptions="Center">
        <HorizontalStackLayout Spacing="10">
            <Slider WidthRequest="300" Minimum="0" Maximum="255" x:Name="Slider_R" VerticalOptions="Center" ValueChanged="Slider_ValueChanged" Value="0"/>
            <Label Text="R: 0" FontSize="Large" x:Name="Label_R"/>
        </HorizontalStackLayout>
        <HorizontalStackLayout Spacing="10">
            <Slider WidthRequest="300" Minimum="0" Maximum="255" x:Name="Slider_G" VerticalOptions="Center" ValueChanged="Slider_ValueChanged" Value="0"/>
            <Label Text="G: 0" FontSize="Large" x:Name="Label_G"/>
        </HorizontalStackLayout>
        <HorizontalStackLayout Spacing="10">
            <Slider WidthRequest="300" Minimum="0" Maximum="255" x:Name="Slider_B" VerticalOptions="Center" ValueChanged="Slider_ValueChanged" Value="0"/>
            <Label Text="B: 0" FontSize="Large" x:Name="Label_B"/>
        </HorizontalStackLayout>
        <HorizontalStackLayout>
            <Label FontSize="Large" x:Name="Kolor_Label" Text="#000000" WidthRequest="400" HorizontalTextAlignment="Center"/>
        </HorizontalStackLayout>
    </VerticalStackLayout>
</ContentPage>